// Prisma Schema for Kraveo Campus Food Delivery Platform

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  VENDOR
  DRIVER
  ADMIN
}

enum AdminAccessRole {
  OWNER
  ADMIN
}

enum AdminAccessStatus {
  INVITED
  ACTIVE
  REVOKED
}

model AdminAccess {
  id          String            @id @default(uuid())
  email       String?           @unique
  userId      String?           @unique
  clerkUserId String?           @unique
  displayName String?
  role        AdminAccessRole   @default(ADMIN)
  status      AdminAccessStatus @default(INVITED)
  invitedById String?
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, role])
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  ARRIVED_AT_GATE
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Dish approval (Docs/21 section 2). Separate from ApprovalStatus (partners) so a dish can never be "SUSPENDED".
enum MenuApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DutyStatus {
  ONLINE
  OFFLINE
  IN_TRANSIT
}

model User {
  id               String    @id @default(uuid())
  clerkUserId      String?   @unique
  phone            String?   @unique
  email            String?   @unique
  googleSub        String?   @unique
  passwordHash     String?
  avatarId         Int?
  isStudent        Boolean?
  name             String
  role             Role      @default(STUDENT)
  hostelBlock      String?
  kraveoCoins      Int       @default(0)
  upiId            String?
  fcmToken         String?
  // Bumped on password reset, suspension and account deletion: JWTs carry `tv` and are refused when it differs.
  tokenVersion     Int       @default(0)
  // Set when the student deletes the account (row is anonymised, kept for order/payment FKs).
  deletedAt        DateTime?
  // How many times 50 coins were exchanged for the KRAVEO20 coupon (each redemption = one use of the code).
  kraveo20Redeemed Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ordersPlaced    Order[]        @relation("CustomerOrders")
  groupsPlaced    OrderGroup[]   @relation("CustomerGroups")
  ordersDriven    Order[]        @relation("DriverOrders")
  driverProfile   DriverPartner?
  vendorsOwned    Vendor[]
  reviewsGiven    ReviewRecord[] @relation("CustomerReviews")
  reviewsReceived ReviewRecord[] @relation("DriverReviews")
  deviceTokens    DeviceToken[]
  payoutAccount   PayoutAccount?
  addresses       Address[]
  supportCases    SupportCase[]
  adminAccess     AdminAccess?
}

// Independent provider subject state survives deidentification and webhook reordering.
model ClerkIdentityState {
  clerkUserId     String   @id
  lastEventAt     BigInt   @default(0)
  deleted         Boolean  @default(false)
  suspended       Boolean  @default(false)
  deleteRequested Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model ClerkWebhookDelivery {
  id             String   @id
  clerkUserId    String
  type           String
  eventTimestamp BigInt
  processedAt    DateTime @default(now())

  @@index([processedAt])
}

model Vendor {
  preparationMinutes Int            @default(10)
  maxPreparingOrders Int            @default(10)
  busyUntil          DateTime?
  id                 String         @id @default(uuid())
  userId             String?
  name               String
  primaryCategoryId  String?
  publicPhone        String?
  description        String?
  primaryCategory    Category?      @relation("PrimaryStoreCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  category           String
  rating             Float          @default(0.0)
  totalRatingsCount  Int            @default(0)
  eta                String         @default("20-25 min")
  bannerImage        String
  address            String
  isAcceptingOrders  Boolean        @default(true)
  lat                Float          @default(0)
  lng                Float          @default(0)
  cityId             String?
  pinCode            String?
  locality           String?
  operatingHours     Json?
  // Where the pin came from (Docs/20): DEVICE = the restaurant's own phone, ADMIN = typed by Kraveo, null = never set / legacy.
  locationSource     String?
  locationSetAt      DateTime?
  locationAccuracyM  Float?
  // Partner approval: rows created by Kraveo are APPROVED; self sign-ups start PENDING.
  approvalStatus     ApprovalStatus @default(APPROVED)
  rejectionReason    String?
  fssaiNumber        String?
  appliedAt          DateTime?
  reviewedAt         DateTime?
  // Docs/21: this restaurant's default commission (PERCENT | FLAT). Both null = inherit the global default.
  commissionType     String?
  commissionValue    Float?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  menuItems   MenuItem[]
  orders      Order[]
  reviews     ReviewRecord[]
  settlements Settlement[]
  // Docs/23: the managed categories (cuisines) of this restaurant, ordered by `position` (first = main). `category` above is DERIVED from them.
  cuisines    VendorCategory[]
  city        City?             @relation(fields: [cityId], references: [id], onDelete: Restrict)
  coverage    VendorCoverage[]
  compliance  SellerCompliance?

  @@index([primaryCategoryId])
  @@index([approvalStatus])
  @@index([cityId, approvalStatus, isAcceptingOrders, lat, lng])
}

model MenuItem {
  batchTracking Boolean      @default(false)
  stockBatches  StockBatch[]
  id            String       @id @default(uuid())
  vendorId      String
  name          String
  // The CUSTOMER price (what the apps and the cart read). The restaurant's own price is `vendorPrice`.
  price         Float
  // Display name of the dish's category, kept in sync with Category.name (Docs/23). Old app builds read this string.
  category      String
  // Docs/23: the managed category (null only for legacy rows the backfill could not match). ON DELETE RESTRICT.
  categoryId    String?
  description   String
  imageUrl      String
  isAvailable   Boolean      @default(true)
  isVeg         Boolean      @default(true)
  rating        Float?       @default(0.0)
  ratingCount   Int?         @default(0)
  createdAt     DateTime     @default(now())

  // Pricing and catalog approval (Docs/21 sections 2-4). `price` = roundUp(vendorPrice + commission, step), recomputed on every change.
  // No default on vendorPrice on purpose: a writer that forgets it fails loudly instead of paying a restaurant Rs 0.
  vendorPrice        Float
  // Dish-level commission override (PERCENT | FLAT). Both null = inherit the restaurant's, then the global default.
  commissionType     String?
  commissionValue    Float?
  approvalStatus     MenuApprovalStatus @default(APPROVED)
  // PENDING dish rejected: why. On a LIVE dish: why the last price-change request was declined.
  rejectionReason    String?
  // A price change the restaurant asked for on a LIVE dish; the dish keeps selling at the old price until an admin accepts it.
  pendingVendorPrice Float?
  // Soft delete: hidden from customers and restaurants, kept so old orders keep their copies.
  deletedAt          DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  createdBy          String             @default("VENDOR") // VENDOR | ADMIN
  updatedAt          DateTime           @default(now()) @updatedAt

  // Each menu row is one sellable SKU/pack; productKey groups variants inside this store.
  imageUrls             String[]               @default([])
  sku                   String?
  productKey            String?
  unit                  String                 @default("pcs")
  packSize              String                 @default("1")
  mrpPaise              Int?
  barcode               String?
  hsnCode               String?
  taxRateBps            Int                    @default(0)
  stockQty              Int                    @default(0)
  stockVersion          Int                    @default(0)
  lowStockThreshold     Int                    @default(5)
  inventoryReservations InventoryReservation[]
  stockMovements        StockMovement[]

  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryRef Category?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@unique([vendorId, sku])
  @@index([vendorId, productKey])
  @@index([vendorId, stockQty])
  @@index([vendorId, approvalStatus, deletedAt])
  @@index([approvalStatus, deletedAt])
  @@index([categoryId])
}

/// Docs/23: ONE managed list for restaurants (many per restaurant, via VendorCategory) and dishes (exactly one, MenuItem.categoryId).
/// `slug` (lower case, [^a-z0-9]+ -> "-") is the uniqueness key, so names are unique ignoring case and spacing.
model Category {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  nameHi         String?
  icon           String   @default("restaurant")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  forRestaurants Boolean  @default(true)
  forDishes      Boolean  @default(true)
  showOnHome     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  menuItems      MenuItem[]
  vendors        VendorCategory[]
  primaryVendors Vendor[]         @relation("PrimaryStoreCategory")

  @@index([isActive, sortOrder])
}

/// A restaurant's category (cuisine) tag. Deleting a restaurant removes its tags; a category in use cannot be deleted (RESTRICT).
model VendorCategory {
  vendorId   String
  categoryId String
  position   Int

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([vendorId, categoryId])
  @@index([categoryId])
}

model Order {
  preparationMinutes      Int?
  estimatedReadyAt        DateTime?
  packingStartedAt        DateTime?
  readyForPickupAt        DateTime?
  riderArrivedPickupAt    DateTime?
  dispatchSearchStartedAt DateTime?
  dispatchOverrideUntil   DateTime?
  capacitySnapshot        Json?
  adjustments             OrderAdjustment[]
  refundRequests          PaymentRefund[]
  workflowVersion         Int               @default(1)
  paymentMethod           String            @default("ONLINE")
  cashCollection          CashCollection?
  id                      String            @id @default(uuid())
  customerId              String
  vendorId                String
  driverId                String?
  totalAmount             Float
  deliveryFee             Float             @default(30.0)
  dropoffHostel           String
  dropoffNotes            String?
  addressId               String?
  addressSnapshot         Json?
  deliveryAddress         Address?          @relation(fields: [addressId], references: [id], onDelete: SetNull)
  status                  OrderStatus       @default(PLACED)
  paymentStatus           PaymentStatus     @default(PENDING)
  otpCode                 String?
  isReviewed              Boolean           @default(false)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  // Order flow v1 (Docs/16_order_flow_contract.md). Price parts are stored so history never changes.
  subtotal         Float     @default(0)
  taxAndPackaging  Float     @default(0)
  discount         Float     @default(0)
  // The coupon that produced `discount` (normalised, upper case). A code is single use per customer
  // while a non-CANCELLED order holds it; cancelling releases it.
  couponCode       String?
  // Idempotency key made by the app per checkout attempt (unique per customer).
  clientRequestId  String?
  paidAt           DateTime?
  acceptedAt       DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelledBy      String? // CUSTOMER | VENDOR | ADMIN | SYSTEM
  cancelReason     String?
  // Gate OTP brute-force guard: 5 wrong attempts lock the order until an admin unlocks it.
  otpAttempts      Int       @default(0)
  otpLocked        Boolean   @default(false)
  // HMAC of (orderId, code) written at delivery: lets a rider's retry of the SAME code answer "already delivered"
  // while a wrong code on a delivered order is refused. The plain code is never kept (otpCode = 'USED').
  otpProof         String?
  // Refund bookkeeping: null/NONE | PENDING | DONE | FAILED. The lease stops two workers refunding at once.
  refundStatus     String?
  refundError      String?
  refundAttempts   Int       @default(0)
  refundLeaseUntil DateTime?

  // Docs/21 section 2. `deliveryFee` now holds the ONE all-in fee and `taxAndPackaging` stays 0 for new orders.
  // vendorSubtotal = sum(vendorUnitPrice x qty) (what the restaurant earns), commissionTotal = subtotal - vendorSubtotal.
  vendorSubtotal  Float   @default(0)
  commissionTotal Float   @default(0)
  feeBreakdown    Json?
  // Docs/21 phase 2: the daily settlement batch this order was paid out in (null = not settled yet). An order belongs to at most
  // one settlement (set by a conditional update); deleting a settlement row frees its orders (ON DELETE SET NULL).
  settlementId    String?

  // Docs/22 multi-restaurant orders: every child of an OrderGroup is an ordinary order. groupIndex 0 = the PRIMARY child: it carries the
  // one Payment (amount = the group total), the base fee and the coupon code. groupId is immutable once set; groups are never deleted.
  groupId    String?
  groupIndex Int?

  customer              User                   @relation("CustomerOrders", fields: [customerId], references: [id])
  vendor                Vendor                 @relation(fields: [vendorId], references: [id])
  driver                User?                  @relation("DriverOrders", fields: [driverId], references: [id])
  settlement            Settlement?            @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  group                 OrderGroup?            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  inventoryReservations InventoryReservation[]
  items                 OrderItem[]
  payments              Payment[]
  review                ReviewRecord?

  pickupArrivalAt       DateTime?
  otpExpiresAt          DateTime?
  dispatchRound         Int                  @default(0)
  dispatchNote          String?
  dispatchNextAttemptAt DateTime?
  dispatchEscalatedAt   DateTime?
  dispatchOffers        DispatchOffer[]
  supportCases          SupportCase[]
  notificationIntents   NotificationIntent[]

  @@unique([customerId, clientRequestId])
  @@unique([groupId, groupIndex])
  @@index([groupId])
  @@index([customerId, createdAt])
  @@index([customerId, couponCode])
  @@index([vendorId, status])
  @@index([driverId, status])
  @@index([status, createdAt])
  @@index([status, driverId, paymentStatus])
  @@index([paymentStatus, createdAt])
  @@index([refundStatus])
  @@index([settlementId])
  @@index([status, deliveredAt])
}

/// Docs/22: one checkout, one payment, one rider, one gate handover for several restaurants. The children (Order rows) are normal orders.
model OrderGroup {
  id              String   @id @default(uuid())
  customerId      String
  // The app's checkout id (unique per customer); the children use the derived ids `g:<clientRequestId>:<index>`.
  clientRequestId String
  dropoffHostel   String
  dropoffNotes    String?
  couponCode      String?
  discount        Float    @default(0)
  // Food (customer prices), all fees, and what the customer pays (= subtotal + feeTotal - discount = the sum of the children's totalAmount).
  subtotal        Float
  feeTotal        Float
  totalAmount     Float
  restaurantCount Int
  feeBreakdown    Json?
  createdAt       DateTime @default(now())

  customer User    @relation("CustomerGroups", fields: [customerId], references: [id])
  orders   Order[]

  @@unique([customerId, clientRequestId])
  @@index([customerId, createdAt])
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  menuItemId      String?
  name            String
  quantity        Int
  // The CUSTOMER unit price at order time.
  price           Float
  // Snapshots from the dish at order time (Docs/21): what the restaurant earns per unit and what Kraveo keeps per unit.
  vendorUnitPrice Float   @default(0)
  commissionUnit  Float   @default(0)
  productSnapshot Json?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  providerStatus          String?
  lastProviderCheckedAt   DateTime?
  verificationRequestedAt DateTime?
  providerFailureCode     String?
  refundRequests          PaymentRefund[]
  id                      String          @id @default(uuid())
  orderId                 String
  razorpayOrderId         String          @unique
  razorpayPaymentId       String?
  amount                  Float
  status                  PaymentStatus   @default(PENDING)
  createdAt               DateTime        @default(now())
  // What Razorpay says was captured (paise), the refund that returned it, and when.
  capturedAmountPaise     Int?
  razorpayRefundId        String?
  refundedAt              DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model DriverPartner {
  id                       String         @id @default(uuid())
  userId                   String?        @unique
  name                     String
  phone                    String
  studentRegNo             String?
  runnerCode               String         @unique
  avatarUrl                String?
  vehicleType              String
  vehicleRegNo             String?
  emergencyPhone           String?
  dutyStatus               DutyStatus     @default(OFFLINE)
  ordersToday              Int            @default(0)
  totalEarningsToday       Float          @default(0.0)
  avgCompletionTimeMinutes Float          @default(0.0)
  onTimeRatePercent        Float          @default(0.0)
  rating                   Float          @default(0.0)
  upiId                    String?
  cityId                   String?
  approvalStatus           ApprovalStatus @default(APPROVED)
  rejectionReason          String?
  appliedAt                DateTime?
  reviewedAt               DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  city City? @relation(fields: [cityId], references: [id], onDelete: Restrict)

  serviceZoneId              String?
  serviceZone                DeliveryZone?   @relation(fields: [serviceZoneId], references: [id], onDelete: SetNull)
  availabilityLat            Float?
  availabilityLng            Float?
  availabilityAt             DateTime?
  lastOfferedAt              DateTime?
  offers                     DispatchOffer[]
  availabilityAccuracyMeters Float?
  availabilityMeasuredAt     DateTime?

  @@index([cityId, approvalStatus, dutyStatus])
  @@index([approvalStatus])
}

// India-wide serviceability. Existing stores are deliberately not auto-enabled in a city.
model City {
  id         String          @id @default(uuid())
  code       String          @unique
  name       String
  state      String
  country    String          @default("IN")
  codEnabled Boolean         @default(false)
  active     Boolean         @default(false)
  createdAt  DateTime        @default(now())
  zones      DeliveryZone[]
  vendors    Vendor[]
  addresses  Address[]
  drivers    DriverPartner[]
}

model DeliveryZone {
  id            String           @id @default(uuid())
  cityId        String
  name          String
  centerLat     Float
  centerLng     Float
  radiusKm      Float
  baseFeePaise  Int              @default(0)
  perKmFeePaise Int              @default(0)
  active        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  city          City             @relation(fields: [cityId], references: [id], onDelete: Restrict)
  vendors       VendorCoverage[]

  riders DriverPartner[]

  @@index([cityId, active])
}

model VendorCoverage {
  vendorId String
  zoneId   String
  active   Boolean      @default(true)
  radiusKm Float?
  vendor   Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  zone     DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([vendorId, zoneId])
  @@index([zoneId, active])
}

model Address {
  id           String   @id @default(uuid())
  customerId   String
  cityId       String
  label        String
  country      String   @default("IN")
  pinCode      String
  locality     String
  houseNumber  String
  street       String
  landmark     String?
  instructions String?
  lat          Float
  lng          Float
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  city         City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  orders       Order[]

  @@index([customerId, createdAt, id])
  @@index([cityId, lat, lng])
}

// Who did what in the admin portal (approvals, suspensions, password resets, manual account creation).
model AdminAuditLog {
  id         String   @id @default(uuid())
  action     String
  targetType String
  targetId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model ReviewRecord {
  id           String   @id @default(uuid())
  orderId      String   @unique
  customerId   String
  vendorId     String
  driverId     String?
  driverRating Float?
  driverTags   String[]
  driverNotes  String?
  dishReviews  Json
  dhabaNotes   String?
  coinsEarned  Int      @default(10)
  createdAt    DateTime @default(now())

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User   @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  driver   User?  @relation("DriverReviews", fields: [driverId], references: [id], onDelete: SetNull)
}

model DriverLocation {
  driverId       String    @id
  driverName     String
  lat            Float
  lng            Float
  heading        Float     @default(0)
  lastUpdated    DateTime  @default(now())
  accuracyMeters Float?
  measuredAt     DateTime?
}

// Push notifications (Docs/18_push_notifications_contract.md). One row per installed app that registered with FCM.
// A token belongs to exactly one user at a time (it MOVES when another user signs in on the same phone).
model DeviceToken {
  id             String    @id @default(uuid())
  userId         String
  token          String    @unique
  app            String // CUSTOMER | VENDOR | DRIVER
  platform       String    @default("android")
  appVersion     String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  disabledAt     DateTime?
  disabledReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

// One row per (order, event, user): the idempotency key AND the delivery log. No foreign keys on purpose, so orders and
// users can be removed without touching it; the maintenance job prunes rows after 14 days. lastError is a code only.
model PushLog {
  deliveryOfferId        String?
  deliveryOfferExpiresAt DateTime?
  id                     String    @id @default(uuid())
  key                    String    @unique // `${orderId}:${event}:${userId}`
  orderId                String
  userId                 String
  event                  String
  status                 String // PENDING | SENT | FAILED | SKIPPED
  attempts               Int       @default(0)
  lastError              String?
  nextAttemptAt          DateTime?
  createdAt              DateTime  @default(now())
  sentAt                 DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

// Admin-editable settings, one row per group (fees, commission, rounding, settlement), validated on write (Docs/21 section 2).
// A group with no row uses the defaults in src/services/pricing.ts. Every write is audited (old and new value).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

enum SettlementStatus {
  PENDING
  ON_HOLD
  PAID
  CANCELLED
}

// Docs/21 section 2 (phase 2). Where a restaurant or rider is paid. One row per user. The full bank account number is only ever
// stored encrypted (AES-256-GCM, src/services/payoutCrypto.ts); every API answer carries `accountLast4` only, except the one
// audited admin "reveal" endpoint.
model PayoutAccount {
  id               String    @id @default(uuid())
  userId           String    @unique
  partnerType      String // VENDOR | DRIVER
  method           String // UPI | BANK
  upiId            String?
  accountHolder    String?
  accountNumberEnc String?
  accountLast4     String?
  ifsc             String?
  bankName         String?
  // Set by an admin once the details were checked (a test transfer, a name match). Any change of details clears it.
  verifiedAt       DateTime?
  verifiedBy       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One payout batch for one restaurant. `batchKey` is the IST date (YYYY-MM-DD) for the automatic daily batch, so the daily job can
// never create two for the same restaurant and day; a manual "run now" uses a unique key (M-...). Money is Float rounded to 2
// decimals (all sums are done in integer paise).
model Settlement {
  id               String           @id @default(uuid())
  vendorId         String
  batchKey         String
  // The delivery window covered: first delivery in the batch .. the cut-off instant.
  periodStart      DateTime
  periodEnd        DateTime
  status           SettlementStatus @default(PENDING)
  orderCount       Int
  // Customer food total of the orders (analytics only: never shown to the restaurant).
  foodGross        Float
  // What the restaurant earns: sum of Order.vendorSubtotal.
  vendorAmount     Float
  commissionAmount Float
  adjustmentTotal  Float            @default(0)
  // vendorAmount + adjustmentTotal: what Kraveo pays out.
  netPayable       Float
  // Payout method and MASKED destination at creation time (null = the restaurant had no payout details).
  payoutSnapshot   Json?
  paidAt           DateTime?
  paymentReference String?
  paidBy           String?
  note             String?
  createdBy        String // AUTO | admin user id
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  vendor      Vendor                 @relation(fields: [vendorId], references: [id])
  orders      Order[]
  adjustments SettlementAdjustment[]

  @@unique([vendorId, batchKey])
  @@index([status, createdAt])
  @@index([vendorId, createdAt])
  @@index([createdAt])
}

model SettlementAdjustment {
  id           String   @id @default(uuid())
  settlementId String
  // Signed rupees: + pays the restaurant more, - deducts.
  amount       Float
  reason       String
  // Optional client key: the same key twice on one settlement is the same adjustment (double click).
  requestId    String?
  createdBy    String
  createdAt    DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, requestId])
  @@index([settlementId])
}

// Ledger of what Kraveo paid a rider (riders are not settled daily: Kraveo only keeps the records).
model RiderPayout {
  id           String    @id @default(uuid())
  driverUserId String
  amount       Float
  method       String // UPI | BANK | CASH
  reference    String?
  periodStart  DateTime?
  periodEnd    DateTime?
  note         String?
  createdBy    String
  createdAt    DateTime  @default(now())

  @@unique([driverUserId, reference])
  @@index([driverUserId, createdAt])
  @@index([createdAt])
}

/// Available units are decremented at checkout. Reservation state determines eligible release.
model InventoryReservation {
  packedQty            Int      @default(0)
  unusableQty          Int      @default(0)
  pendingInspectionQty Int      @default(0)
  releasedQty          Int      @default(0)
  batchAllocations     Json     @default("[]")
  id                   String   @id @default(uuid())
  orderId              String
  menuItemId           String
  quantity             Int
  state                String   @default("HELD")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item                 MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([orderId, menuItemId])
  @@index([orderId, state])
}

model StockMovement {
  details    Json?
  id         String   @id @default(uuid())
  menuItemId String
  delta      Int
  kind       String
  reason     String
  actorId    String?
  reference  String   @unique
  createdAt  DateTime @default(now())
  item       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, createdAt])
}

model DispatchOffer {
  id        String        @id @default(uuid())
  orderId   String
  driverId  String
  round     Int           @default(0)
  state     String        @default("PENDING")
  expiresAt DateTime
  reason    String?
  manual    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver    DriverPartner @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([orderId, driverId, round])
  @@index([driverId, state, expiresAt])
  @@index([orderId, state])
}

model SupportCase {
  category             String            @default("OTHER")
  priority             String            @default("NORMAL")
  assignedToId         String?
  dueAt                DateTime?
  escalatedAt          DateTime?
  resolvedAt           DateTime?
  reopenedAt           DateTime?
  refundReference      String?
  replacementReference String?
  evidence             SupportEvidence[]
  id                   String            @id @default(uuid())
  customerId           String
  orderId              String?
  subject              String
  description          String
  status               String            @default("OPEN")
  resolution           String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  customer             User              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order                Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  notes                SupportNote[]

  @@index([status, dueAt])
  @@index([assignedToId, status])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model SupportNote {
  internal    Boolean     @default(false)
  id          String      @id @default(uuid())
  caseId      String
  actorId     String
  message     String
  createdAt   DateTime    @default(now())
  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model NotificationIntent {
  leaseToken String?
  id         String    @id @default(uuid())
  orderId    String
  event      String
  options    Json
  state      String    @default("PENDING")
  attempts   Int       @default(0)
  leaseUntil DateTime?
  errorCode  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([state, leaseUntil, createdAt])
}

// Cash never creates a Razorpay Payment row. Order UUID and server price are immutable.
model CashCollection {
  events              CashLedgerEvent[]
  id                  String            @id @default(uuid())
  orderId             String            @unique
  driverUserId        String
  amountPaise         Int
  collectedAt         DateTime          @default(now())
  remittedAt          DateTime?
  remittanceReference String?
  remittedById        String?
  refundedAt          DateTime?
  refundReference     String?
  refundedById        String?
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([driverUserId, collectedAt])
}

model BackgroundJob {
  name           String             @id
  state          String             @default("READY") // READY | RUNNING | DEAD
  intervalMs     Int
  maxAttempts    Int                @default(8)
  attempts       Int                @default(0)
  nextRunAt      DateTime           @default(now())
  leaseToken     String?
  leaseOwner     String?
  leaseUntil     DateTime?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastSuccessAt  DateTime?
  lastErrorCode  String?
  recoveryCount  Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  runs           BackgroundJobRun[]

  @@index([state, nextRunAt])
  @@index([leaseUntil])
}

model BackgroundJobRun {
  id         String        @id @default(uuid())
  jobName    String
  workerId   String
  state      String // RUNNING | SUCCEEDED | FAILED | ABANDONED
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  leaseUntil DateTime
  errorCode  String?
  recovered  Boolean       @default(false)
  job        BackgroundJob @relation(fields: [jobName], references: [name], onDelete: Cascade)

  @@index([jobName, startedAt])
  @@index([state, leaseUntil])
}

model StockBatch {
  id           String    @id @default(uuid())
  menuItemId   String
  lotCode      String
  availableQty Int       @default(0)
  expiresAt    DateTime?
  receivedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  item         MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, lotCode])
  @@index([menuItemId, expiresAt])
}

model SupportEvidence {
  id           String      @id @default(uuid())
  caseId       String
  uploadedById String
  storageKey   String      @unique
  mime         String
  bytes        Int
  sha256       String
  caption      String?
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  supportCase  SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([expiresAt])
}

model OperationalResolution {
  id                String   @id @default(uuid())
  exceptionKey      String
  referenceType     String
  referenceId       String
  state             String   @default("OPEN")
  ownerId           String?
  reason            String
  evidenceReference String?
  version           Int      @default(1)
  actorId           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([exceptionKey, referenceType, referenceId])
  @@index([state, updatedAt])
}

model CashLedgerEvent {
  id             String          @id @default(uuid())
  collectionId   String?
  driverUserId   String
  kind           String
  amountPaise    Int
  reference      String
  reason         String
  actorId        String
  supervisorId   String?
  businessDate   String
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  collection     CashCollection? @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@index([driverUserId, businessDate, createdAt])
  @@index([collectionId, kind])
}

model CashDailyClose {
  id                String    @id @default(uuid())
  driverUserId      String
  businessDate      String
  expectedPaise     Int
  receivedPaise     Int
  outstandingPaise  Int
  shortagePaise     Int
  overagePaise      Int
  state             String    @default("REVIEW_REQUIRED")
  reason            String
  actorId           String
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  countedPaise      Int
  evidenceReference String

  @@unique([driverUserId, businessDate])
}

// Customer-approved grocery line corrections. Original authorized financial snapshots remain immutable here.
model OrderAdjustment {
  id                 String          @id @default(uuid())
  orderId            String
  customerId         String
  requestedById      String
  requestKey         String
  state              String          @default("PROPOSED")
  version            Int             @default(1)
  reason             String
  originalSnapshot   Json
  proposedItems      Json
  originalTotalPaise Int
  proposedTotalPaise Int
  refundDuePaise     Int             @default(0)
  decisionKey        String?         @unique
  expiresAt          DateTime
  decidedAt          DateTime?
  appliedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refundRequests     PaymentRefund[]

  @@unique([orderId, requestKey])
  @@index([state, expiresAt])
}

// Separate each provider refund request; PENDING/SUBMITTED never means money returned.
model PaymentRefund {
  id               String           @id @default(uuid())
  paymentId        String
  orderId          String
  adjustmentId     String?
  amountPaise      Int
  state            String           @default("PENDING")
  reason           String
  idempotencyKey   String           @unique
  providerRefundId String?          @unique
  submitStartedAt  DateTime?
  leaseToken       String?
  leaseUntil       DateTime?
  attempts         Int              @default(0)
  nextAttemptAt    DateTime         @default(now())
  lastErrorCode    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  processedAt      DateTime?
  payment          Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  adjustment       OrderAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)

  @@index([state, nextAttemptAt, leaseUntil])
  @@index([paymentId, state])
}

model GpsException {
  id                String    @id @default(uuid())
  orderId           String
  scope             String
  reason            String
  evidenceReference String
  requestedById     String
  approvedById      String?
  state             String    @default("PENDING")
  expiresAt         DateTime
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([orderId, scope, state, expiresAt])
}

model SellerCompliance {
  id                   String    @id @default(uuid())
  vendorId             String    @unique
  businessName         String?
  businessAddress      String?
  contactEmail         String?
  contactPhone         String?
  gstApplicable        Boolean?
  gstNumber            String?
  fssaiApplicable      Boolean?
  fssaiNumber          String?
  fssaiExpiresAt       DateTime?
  authorizedSellerName String?
  documentReferences   Json      @default("[]")
  requiredDocuments    Json      @default("[]")
  status               String    @default("DRAFT")
  revision             Int       @default(1)
  reviewedById         String?
  reviewedAt           DateTime?
  reviewReason         String?
  updatedAt            DateTime  @default(now()) @updatedAt
  createdAt            DateTime  @default(now())
  vendor               Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
}

model PaymentCreation {
  id              String   @id @default(uuid())
  orderId         String   @unique
  amountPaise     Int
  state           String   @default("CREATING")
  claimToken      String
  providerOrderId String?  @unique
  lastErrorCode   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}
