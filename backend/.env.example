# Copy to .env locally. Never commit actual credentials.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://agent@127.0.0.1:5432/market_dev
# Generate a unique random secret locally; do not use a shared example value.
JWT_SECRET=
ADMIN_PASSCODE=
# Local development only: API runs, checkout returns a provider-unavailable error.
# Set razorpay and configure real test credentials to exercise gateway sandbox flows.
PAYMENT_PROVIDER=disabled
# Razorpay TEST credentials only for development; leave blank until configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:3000
GOOGLE_WEB_CLIENT_ID=
# Backend-only Firebase service account path. Never place it in a Flutter app.
FIREBASE_KEY_PATH=
# Optional 32-byte base64 key for encrypted bank/UPI account details.
PAYOUT_ENC_KEY=
