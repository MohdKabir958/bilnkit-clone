VITE_API_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
# Production map background: configure a licensed/self-hosted tile template and attribution.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# legacy until approved; use clerk-test only against the isolated staging backend.
VITE_AUTH_MODE=legacy
VITE_CLERK_PUBLISHABLE_KEY=
# API client automatically sends protocol 1/auth mode/public Clerk instance headers.
# Never add CLERK_SECRET_KEY, private Razorpay keys or Firebase service accounts here.
# Before Vercel import, generate exact-origin CSP using scripts/configure_hosted_admin.mjs.
