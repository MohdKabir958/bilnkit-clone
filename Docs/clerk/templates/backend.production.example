# APPROVED CUTOVER ONLY. Production uses a separate Clerk live instance and database.
# Paid Render Starter + persistent disk; review prices before provisioning.
NODE_ENV=production
AUTH_MODE=clerk
DATABASE_URL=postgresql://USER:PASSWORD@NEON-POOLER-HOST/DATABASE?sslmode=require&connection_limit=5&pool_timeout=10
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@NEON-DIRECT-HOST/DATABASE?sslmode=require
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_ISSUER=https://YOUR-LIVE-CLERK-DOMAIN
CLERK_AUTHORIZED_PARTIES=https://YOUR-ADMIN-DOMAIN
CLERK_ALLOW_NATIVE_WITHOUT_AZP=true
CLERK_ADMIN_USER_IDS=
CLERK_AUDIENCE=
# Existing data: preserve old JWT_SECRET value here for delivery-receipt compatibility.
DELIVERY_PROOF_SECRET=
PAYOUT_ENC_KEY=
ADMIN_URL=https://YOUR-ADMIN-DOMAIN
CLIENT_URL=https://YOUR-ADMIN-DOMAIN
PUBLIC_BASE_URL=https://YOUR-API-DOMAIN
UPLOAD_DIR=/var/data/grozo/uploads
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FIREBASE_KEY_PATH=
