# Fill securely, chmod 600, never commit. URL-encode database password in DATABASE_URL.
PUBLIC_HOST=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://market:REPLACE@database:5432/market
JWT_SECRET=
ADMIN_PASSCODE=
ADMIN_URL=https://YOUR_HOST
PUBLIC_BASE_URL=https://YOUR_HOST
UPLOAD_DIR=/var/lib/market/uploads
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_WEB_CLIENT_ID=
FIREBASE_KEY_PATH=/run/secrets/firebase.json
PAYOUT_ENC_KEY=
# Optional owned HTTPS geocoding and routing adapters; leave disabled for manual address entry.
MAPS_GEOCODER_URL=
MAPS_ROUTER_URL=
