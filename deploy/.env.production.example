# Fill securely, chmod 600, never commit. URL-encode database password in DATABASE_URL.
NODE_ENV=production
GROZO_ENV=production
# Preserve the current approved auth mode until owner-approved cutover.
AUTH_MODE=legacy
REQUIRE_CLIENT_CONTRACT=false
MIGRATION_DATABASE_URL=
PUBLIC_HOST=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://market:REPLACE@database:5432/market
JWT_SECRET=
ADMIN_PASSCODE=
ADMIN_URL=https://YOUR_HOST
PUBLIC_BASE_URL=https://YOUR_HOST
UPLOAD_DIR=/var/lib/market/uploads
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_WEB_CLIENT_ID=
FIREBASE_KEY_PATH=/run/secrets/firebase.json
PAYOUT_ENC_KEY=
# Optional owned HTTPS geocoding and routing adapters; leave disabled for manual address entry.
MAPS_GEOCODER_URL=
MAPS_ROUTER_URL=
SUPPORT_EVIDENCE_DIR=/var/lib/market/private/support-evidence
# Only enter these for an explicitly approved Clerk production cutover.
# Publishable key and issuer must identify the same instance; parties are exact frontend origins.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
CLERK_ALLOW_NATIVE_WITHOUT_AZP=false
CLERK_ADMIN_USER_IDS=
CLERK_AUDIENCE=
DELIVERY_PROOF_SECRET=
